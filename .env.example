# AI Film Production Pipeline — Environment Variables
# ─────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your keys.
# The pipeline auto-detects which providers are available
# and routes to the best one automatically.
#
# PRIORITY ORDER (first key found wins per tier):
#   OmniRoute → OpenRouter → Anthropic → Gemini → NVIDIA NIM →
#   DeepSeek → Qwen → OpenAI → HuggingFace (always free)
# ─────────────────────────────────────────────────────────────

# ── OmniRoute ──────────────────────────────────────────────
# Connects all your providers through one endpoint.
# Set this and it will automatically use the best model per agent.
OMNIROUTE_API_KEY=your_omniroute_key_here
# OMNIROUTE_BASE_URL=https://omniroute.ai/v1   # Only if non-default

# ── OpenRouter ─────────────────────────────────────────────
# Gives access to 200+ models, many with free tier.
# Free models: gemini-2.0-flash-exp, deepseek-chat-v3:free, qwen3-8b:free
OPENROUTER_API_KEY=your_openrouter_key_here

# ── Google Gemini Pro ───────────────────────────────────────
GOOGLE_API_KEY=your_google_api_key_here
# GEMINI_API_KEY=same_as_above  # Alternative env var name

# ── Anthropic (OpenCode Go uses this) ──────────────────────
ANTHROPIC_API_KEY=your_anthropic_key_here

# ── DeepSeek ───────────────────────────────────────────────
# DeepSeek Chat: ~$0.00014/1K input tokens (near-free)
# DeepSeek R1 Reasoner: best reasoning, still cheap
DEEPSEEK_API_KEY=your_deepseek_key_here

# ── Qwen Cloud (Alibaba) ────────────────────────────────────
# Qwen Turbo: very cheap, fast
# DASHSCOPE_API_KEY is the official Alibaba env var name
QWEN_API_KEY=your_qwen_key_here
# DASHSCOPE_API_KEY=same_as_above  # Alibaba's official name

# ── NVIDIA NIM ──────────────────────────────────────────────
# Free tier available — Llama 3.1, Nemotron, Mistral
# Sign up at: https://build.nvidia.com
NVIDIA_API_KEY=your_nvidia_nim_key_here

# ── OpenAI (standard) ──────────────────────────────────────
OPENAI_API_KEY=your_openai_key_here

# ── HuggingFace ────────────────────────────────────────────
# Most models work without a key (free anonymous inference)
# Set this for higher rate limits
HF_TOKEN=your_huggingface_token_here

# ─────────────────────────────────────────────────────────
# VIDEO GENERATION
# ─────────────────────────────────────────────────────────

# ── Krea AI (Universal Video API — docs.krea.ai) ───────────
# Supports Google Veo 3.1, Kling 3.0, Wan 2.5 through a single key
KREA_API_KEY=your_krea_api_token_here

# ── fal.ai — cheapest paid option ($0.01–0.10/clip) ────────
FAL_KEY=your_fal_key_here

# ── Replicate — similar to fal.ai ──────────────────────────
REPLICATE_API_TOKEN=your_replicate_token_here

# ── Google Veo (best quality, higher cost) ──────────────────
# Uses same GOOGLE_API_KEY as above

# ── Kling AI (Multi-Account Free Credits — klingai.com) ──────
# Account 1 (Google Account 1)
KLING_ACCESS_KEY_1=your_kling_access_key_1_here
KLING_SECRET_KEY_1=your_kling_secret_key_1_here
KLING_API_KEY_1=your_kling_api_key_1_here

# Account 2 (Google Account 2 — Auto-failover when Account 1 runs out)
KLING_ACCESS_KEY_2=your_kling_access_key_2_here
KLING_SECRET_KEY_2=your_kling_secret_key_2_here
KLING_API_KEY_2=your_kling_api_key_2_here

# ─────────────────────────────────────────────────────────
# AUDIO
# ─────────────────────────────────────────────────────────

# ── ElevenLabs (10,000 chars/month FREE) ───────────────────
ELEVENLABS_API_KEY=your_elevenlabs_key_here

# ── Edge TTS — completely free, no key needed ───────────────
# No key needed — built into the pipeline as fallback

# ─────────────────────────────────────────────────────────
# IMAGE GENERATION
# ─────────────────────────────────────────────────────────

# ── Stability AI ───────────────────────────────────────────
STABILITY_API_KEY=your_stability_key_here

# ─────────────────────────────────────────────────────────
# ROUTING OVERRIDES (optional — force specific models)
# ─────────────────────────────────────────────────────────
# Uncomment to override auto-routing for specific agents:
# DIRECTOR_MODEL=anthropic/claude-opus-4-5
# QC_MODEL=deepseek/deepseek-chat
# PROMPT_BUILDER_MODEL=qwen/qwen3-8b
